# Supabase user-db connection. Copy to .env, then fill real values.
USER_DB_HOST=your-user-project-ref.pooler.supabase.com
USER_DB_PORT=5432
USER_DB_NAME=postgres
USER_DB_USERNAME=postgres.your-user-project-ref
USER_DB_PASSWORD=replace-with-supabase-database-password

# Supabase customer-db connection, a SEPARATE project from user-db.
CUSTOMER_DB_HOST=your-customer-project-ref.pooler.supabase.com
CUSTOMER_DB_PORT=5432
CUSTOMER_DB_NAME=postgres
CUSTOMER_DB_USERNAME=postgres.your-customer-project-ref
CUSTOMER_DB_PASSWORD=replace-with-supabase-database-password

# Supabase CRM project, a THIRD separate project. Holds projects/products/leads/
CRM_DB_HOST=your-crm-project-ref.pooler.supabase.com
CRM_DB_PORT=5432
CRM_DB_NAME=postgres
CRM_DB_USERNAME=postgres.your-crm-project-ref
CRM_DB_PASSWORD=replace-with-supabase-database-password

# Base64-encoded random key. Must decode to at least 32 bytes for HS256.
# Shared by every service; they all verify tokens issued by user-service.
# Generate: openssl rand -base64 32
JWT_SECRET=replace-with-openssl-rand-base64-32-output

# BCrypt hash used when login identifier does not exist, reducing timing leaks.
# Generate for any throwaway value: htpasswd -bnBC 12 "" 'not-a-real-password' | tr -d ':\n'
DUMMY_BCRYPT_HASH=replace-with-bcrypt-hash

# JWT lifetimes. Access token stays short; refresh token supports sign-in persistence.
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# Failed login attempts per account within 15 minutes before temporary block.
MAX_LOGIN_ATTEMPTS=5

# Nguong rieng cho IP trong cung 15 phut. Cao hon nguong tai khoan vi nhieu
# nhan vien co the di chung mot NAT, va 5 lan go nham cua nguoi khac khong nen
# khoa ca van phong.
MAX_LOGIN_ATTEMPTS_IP=20

# Do NOT set a shared SERVER_PORT here. Each service declares its own default
# (gateway 8080, user 8081, customer 8082) and Docker overrides it per service.
SPRING_CLOUD_CONSUL_HOST=localhost
SPRING_CLOUD_CONSUL_PORT=8500

# SMTP for mail-service, the only service that talks to a mail server. OTP and
# any future notification email go through it. Use an app password, never the
# mailbox login password.
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@your-domain.com
MAIL_PASSWORD=replace-with-smtp-app-password
# Envelope sender shown to recipients; usually equals MAIL_USERNAME.
MAIL_FROM=no-reply@your-domain.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

# OTP lifetime and the issuer name shown in authenticator apps for 2FA.
OTP_TTL=5m
OTP_ISSUER=EstateCRM

# API gateway hardening. Add production frontend domains comma-separated; do not
# use '*' because browser requests carry Bearer tokens.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
GATEWAY_AUTH_RATE_LIMIT_MAX_REQUESTS=20
GATEWAY_AUTH_RATE_LIMIT_WINDOW=1m
GATEWAY_MAX_REQUEST_BODY=1MB
GATEWAY_MAX_INITIAL_LINE_LENGTH=4KB
GATEWAY_MAX_HEADER_SIZE=16KB
