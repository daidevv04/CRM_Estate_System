# Ports. Doi port chi sua mot cho: dev-up.ps1 dat SERVER_PORT cho tung tien trinh,
# va gateway goi cac service theo cac port nay.
GATEWAY_PORT=8080
# 8081 co the bi McAfee Agent (macmnsvc) chiem tren Windows -> 8091 la mac dinh an toan.
# Gateway route qua Consul nen doi port khong can sua code.
USER_SERVICE_PORT=8091
CUSTOMER_SERVICE_PORT=8082
CRM_SERVICE_PORT=8083
MAIL_SERVICE_PORT=8084
CONFIG_SERVICE_PORT=8888

# Gioi han heap cho moi JVM. dev-up.ps1 da dat mac dinh du cho may 2GB
# (~1.6-1.8GB tong khi chay ca 6 service). May >=4GB thi doi gia tri $javaFlags trong dev-up.ps1.
# JAVA_TOOL_OPTIONS=-Xmx384m -XX:MaxMetaspaceSize=192m -XX:+UseSerialGC -Xss512k

# Supabase user-db connection. Copy to .env, then fill real values.
USER_DB_HOST=your-user-project-ref.pooler.supabase.com
USER_DB_PORT=5432
USER_DB_NAME=postgres
USER_DB_USERNAME=postgres.your-user-project-ref
USER_DB_PASSWORD=replace-with-supabase-database-password

# Supabase customer-db connection, a SEPARATE project from user-db.
CUSTOMER_DB_HOST=your-customer-project-ref.pooler.supabase.com
CUSTOMER_DB_PORT=5432
CUSTOMER_DB_NAME=postgres
CUSTOMER_DB_USERNAME=postgres.your-customer-project-ref
CUSTOMER_DB_PASSWORD=replace-with-supabase-database-password

# Supabase CRM project, a THIRD separate project. Holds projects/products/leads/
CRM_DB_HOST=your-crm-project-ref.pooler.supabase.com
CRM_DB_PORT=5432
CRM_DB_NAME=postgres
CRM_DB_USERNAME=postgres.your-crm-project-ref
CRM_DB_PASSWORD=replace-with-supabase-database-password

# Base64-encoded random key. Must decode to at least 32 bytes for HS256.
# Shared by every service; they all verify tokens issued by user-service.
# Generate: openssl rand -base64 32
JWT_SECRET=replace-with-openssl-rand-base64-32-output

# BCrypt hash used when login identifier does not exist, reducing timing leaks.
# Generate for any throwaway value: htpasswd -bnBC 12 "" 'not-a-real-password' | tr -d ':\n'
DUMMY_BCRYPT_HASH=replace-with-bcrypt-hash

# JWT lifetimes. Access token stays short; refresh token supports sign-in persistence.
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# Failed login attempts per account within 15 minutes before temporary block.
# Da chuyen sang services/config-service/config-repo/user-service.properties (key
# app.auth.max-login-attempts). Dat bien APP_AUTH_MAX_LOGIN_ATTEMPTS neu can override.

# Nguong rieng cho IP trong cung 15 phut. Cao hon nguong tai khoan vi nhieu
# nhan vien co the di chung mot NAT, va 5 lan go nham cua nguoi khac khong nen
# khoa ca van phong. Cung da chuyen sang config-repo
# (app.auth.max-login-attempts-ip); override bang APP_AUTH_MAX_LOGIN_ATTEMPTS_IP.

# Do NOT set a shared SERVER_PORT here. Each service declares its own default
# (gateway 8080, user 8081, customer 8082) and dev-up.ps1 sets it per process.
SPRING_CLOUD_CONSUL_HOST=localhost
SPRING_CLOUD_CONSUL_PORT=8500
# Noi khong co Consul (Render...) dat CONSUL_ENABLED=false: tat consul discovery +
# health indicator 'consul' (khong tat thi /actuator/health DOWN).
# Route cua gateway mac dinh la lb://<ten-service> (can Consul); khi khong co Consul
# thi dat USER_SERVICE_URI / CUSTOMER_SERVICE_URI / CRM_SERVICE_URI = https://host that.
CONSUL_ENABLED=true

# Gui mail qua Resend API (HTTPS), khong dung SMTP: Render free chan outbound
# 25/465/587 con HTTPS thi khong. Lay key tai https://resend.com/api-keys
# (free ~3.000 mail/thang, 100 mail/ngay).
RESEND_API_KEY=re_replace-with-your-resend-key
# Sender phai thuoc domain da verify tren Resend. Format: "Ten hien thi <dia chi>"
MAIL_FROM=EstateCRM <no-reply@your-domain.com>
# user-service/customer-service goi mail-service qua HTTP. Doi port mail-service
# thi phai sua ca dong nay.
MAIL_SERVICE_URL=http://localhost:8084

# OTP lifetime and the issuer name shown in authenticator apps for 2FA.
# Da chuyen sang config-repo/user-service.properties (app.auth.otp-ttl, app.auth.otp-issuer).

# Basic auth cho config-service. Bat buoc phai co: response cua no chua cau hinh
# moi truong cua toan he thong, nen khong duoc de lo. Client dat
# spring.cloud.config.username/password tuong ung.
CONFIG_SERVER_USERNAME=config-admin
CONFIG_SERVER_PASSWORD=replace-with-strong-password
# config-service o localhost khi chay bang dev-up.ps1. Doi dong nay neu no o host khac.
CONFIG_SERVER_URL=http://localhost:8888

# API gateway hardening. Add production frontend domains comma-separated; do not
# use '*' because browser requests carry Bearer tokens.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Rate limit cua nhom API dang nhap da chuyen sang config-repo/api-gateway-service.properties
# (app.gateway.auth-rate-limit.*); override bang APP_GATEWAY_AUTH_RATE_LIMIT_MAX_REQUESTS neu can.
GATEWAY_MAX_REQUEST_BODY=1MB
GATEWAY_MAX_INITIAL_LINE_LENGTH=4KB
GATEWAY_MAX_HEADER_SIZE=16KB
